# Environment configuration example file

# OPC UA configuration
vPLC_Runtime=wsl
OPCUA_URL=opc.tcp://localhost:4840
OPCUA_USER=
OPCUA_PASSWORD=

# PostgreSQL configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
POSTGRES_DB=data_base
POSTGRES_HOST=db
POSTGRES_PORT=5432

# N8N configuration
GENERIC_TIMEZONE=Europe/Oslo

# OpenAI API Key(s)
OPENAI_API_KEY=
# For multiple accounts, add: OPENAI_API_KEY_2=
